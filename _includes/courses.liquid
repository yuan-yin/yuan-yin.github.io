{% if site.teachings %}
  <div class="courses">
    {% comment %} One card per course, however many years it ran; newest first {% endcomment %}
    {% assign course_groups = site.teachings | sort: 'year' | reverse | group_by: 'title' %}
    <div class="course-list">
      {% for course_group in course_groups %}
        {% assign course = course_group.items | first %}
        {% assign course_type_slug = course.type | downcase | replace: '/', '-' | replace: ' ', '-' %}
        <article class="course-card course-card--{{ course_type_slug }}">
          <div class="course-card__meta">
            <span class="course-card__type">{{ course.type }}</span>
            <span class="course-card__dot" aria-hidden="true"></span>
            <span class="course-card__term">
              {%- for run in course_group.items -%}
                {{- run.term }}
                {{ run.year -}}
                {%- unless forloop.last %}, {% endunless -%}
              {%- endfor -%}
            </span>
          </div>

          <h3 class="course-card__title">{{ course.title }}</h3>

          {% if course.instructor or course.time %}
            <div class="course-card__details">
              {% if course.instructor %}
                <span class="course-card__detail">
                  <i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>
                  <span>{{ course.instructor }}</span>
                </span>
              {% endif %}
              {% if course.time %}
                <span class="course-card__detail">
                  <i class="fa-regular fa-clock" aria-hidden="true"></i>
                  <span>{{ course.time }}</span>
                </span>
              {% endif %}
            </div>
          {% endif %}

          {% if course.description %}
            <div class="course-card__description">
              {{ course.description | markdownify }}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
