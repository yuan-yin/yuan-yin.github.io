{% comment %}
  Venue colors and chip shared by the full and compact publication cards. Sets
  primary_kind, venue_color and venue_chip (rendered HTML) for the calling card.
{% endcomment %}
{% assign venue_source = entry.venues | default: '' | replace: ';', '|' %}
{% assign venue_labels = venue_source | split: '|' %}
{% assign venue_label = venue_labels | first | strip %}
{% assign primary_kind = site.data.venues[venue_label].kind | default: 'other' | downcase | strip %}
{% if primary_kind == blank %}
  {% assign primary_kind = 'other' %}
{% endif %}
{% assign venue_key = venue_label %}

{% assign venue_color = '' %}
{% if site.data.venues[venue_key].color != blank %}
  {% assign venue_color = site.data.venues[venue_key].color %}
{% endif %}
{% if venue_color == blank %}
  {% case primary_kind %}
    {% when 'journal' %}
      {% assign venue_color = '#0f766e' %}
    {% when 'conference' %}
      {% assign venue_color = '#7c3aed' %}
    {% when 'workshop' %}
      {% assign venue_color = '#ea580c' %}
    {% when 'thesis' %}
      {% assign venue_color = '#475569' %}
    {% when 'preprint' %}
      {% assign venue_color = '#64748b' %}
    {% else %}
      {% assign venue_color = '#9678b6' %}
  {% endcase %}
{% endif %}
{% capture venue_gradient -%}
  linear-gradient(135deg
  {%- for venue_name_raw in venue_labels -%}
    {%- assign venue_name = venue_name_raw | strip -%}
    {%- assign venue_chip_color = '' -%}
    {%- if site.data.venues[venue_name].color != blank -%}
      {%- assign venue_chip_color = site.data.venues[venue_name].color -%}
    {%- endif -%}
    {%- if venue_chip_color == blank -%}
      {%- assign chip_kind = site.data.venues[venue_name].kind | downcase | strip -%}
      {%- if chip_kind == blank -%}
        {%- assign chip_kind = primary_kind -%}
      {%- endif -%}
      {%- case chip_kind -%}
        {%- when 'journal' -%}
          {%- assign venue_chip_color = '#0f766e' -%}
        {%- when 'conference' -%}
          {%- assign venue_chip_color = '#7c3aed' -%}
        {%- when 'workshop' -%}
          {%- assign venue_chip_color = '#ea580c' -%}
        {%- when 'thesis' -%}
          {%- assign venue_chip_color = '#475569' -%}
        {%- when 'preprint' -%}
          {%- assign venue_chip_color = '#64748b' -%}
        {%- else -%}
          {%- assign venue_chip_color = venue_color -%}
      {%- endcase -%}
    {%- endif -%}
    , {{ venue_chip_color }}
  {%- endfor -%}
  {%- if venue_labels.size == 1 -%}
    , {{ venue_color }}
  {%- endif -%}
  )
{%- endcapture %}
{% capture venue_chip %}
      {%- if entry.venues -%}
        <div
          class="badge rounded-pill publication-card__venue publication-card__venue--merged"
          style="--venue-accent: {{ venue_color }}; --venue-gradient: {{ venue_gradient | strip }};"
        >
          {%- for venue_name_raw in venue_labels -%}
            {% assign venue_name = venue_name_raw | strip %}
            {% assign item_kind = site.data.venues[venue_name].kind | default: primary_kind | downcase | strip %}
            {% assign item_color = site.data.venues[venue_name].color %}
            {% if item_color == blank %}
              {% case item_kind %}
                {% when 'journal' %}
                  {% assign item_color = '#0f766e' %}
                {% when 'conference' %}
                  {% assign item_color = '#7c3aed' %}
                {% when 'workshop' %}
                  {% assign item_color = '#ea580c' %}
                {% when 'thesis' %}
                  {% assign item_color = '#475569' %}
                {% when 'preprint' %}
                  {% assign item_color = '#64748b' %}
                {% else %}
                  {% assign item_color = venue_color %}
              {% endcase %}
            {% endif %}
            {%- if venue_name != blank -%}
              <span class="publication-card__venue-item" style="--venue-item-accent: {{ item_color }};">
                {% unless item_kind == 'preprint' and venue_name == 'Preprint' %}
                  <span class="publication-card__type">{{ item_kind | capitalize }}</span>
                  <span class="publication-card__dot" aria-hidden="true"></span>
                {% endunless %}
                {% if site.data.venues[venue_name].url %}
                  <a class="publication-card__venue-name" href="{{ site.data.venues[venue_name].url }}">{{ venue_name }}</a>
                {% else %}
                  <span class="publication-card__venue-name">{{ venue_name }}</span>
                {% endif %}
              </span>
              {% unless forloop.last -%}
                <span class="publication-card__venue-chip-separator" aria-hidden="true">+</span>
              {%- endunless %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {% else %}
        <span class="publication-card__type">{{ primary_kind | capitalize }}</span>
      {% endif %}
{% endcapture %}
