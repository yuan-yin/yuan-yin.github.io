    .pdf-stage {
      position: relative;
      width: 100%;
      max-width: 100%;
      /* A4 (210 x 297 mm) — matches the source PDFs. The stage clips overflow,
         so a shorter ratio here crops the bottom of every rendered page. */
      min-height: min(720px, calc((100vw - 2rem) * 1.4142));
      aspect-ratio: 210 / 297;
      background:
        linear-gradient(90deg, transparent 0, rgba(150, 120, 182, 0.08) 50%, transparent 100%),
        linear-gradient(var(--global-bg-color), var(--global-bg-color)), var(--global-card-bg-color);
      background-size:
        240% 100%,
        calc(100% - 4rem) calc(100% - 4rem),
        auto;
      background-position:
        120% 0,
        2rem 2rem,
        0 0;
      background-repeat: no-repeat;
      border: 1px solid var(--global-divider-color);
      border-radius: 2px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      /* Side sheets overhang the stage into the page gutters */
      overflow: visible;
      line-height: 0;
      transition:
        background-color 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
    }

    .cv-loading .pdf-stage {
      animation: pdf-loading-sheen 1.4s ease-in-out infinite;
    }

    @keyframes pdf-loading-sheen {
      0% {
        background-position:
          120% 0,
          2rem 2rem,
          0 0;
      }
      100% {
        background-position:
          -120% 0,
          2rem 2rem,
          0 0;
      }
    }

    /* Keep the overhanging sheets from causing horizontal page scroll.
       (clip, not hidden: hidden would break the sticky toolbar) */
    body {
      overflow-x: clip;
    }

    /* Page deck: the current page fills the stage exactly as before; the
       neighbor pages are full-size sheets stacked BEHIND it, sticking out
       into the side gutters. Clicking one brings it to the center. */
    .pdf-page {
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      line-height: 0;
    }

    .pdf-page--current {
      position: relative;
      z-index: 1;
    }

    /* Side sheets are fixed-width windows in the gutters, flush against the
       stage edges, clipping a full-size render of their page. Like pages in
       a row: the left window shows the previous page's RIGHT edge, the right
       window shows the next page's LEFT edge. */
    .pdf-page--prev,
    .pdf-page--next {
      position: absolute;
      /* No top:50% + translateY: an ancestor transform shifts the painted
         position of the sticky chevron, desyncing it from the loop-back
         icon. Same geometry as .pdf-restart instead. */
      top: 0;
      height: 100%;
      /* Fill the whole gutter: from the stage edge to the screen edge
         (minus a small breathing gap), so nothing gets clipped. */
      width: calc(50vw - 50% - 0.75rem);
      /* clip, not hidden: hidden would make this a scroll container and
         break the sticky chevron (it would stick to the zone, not the
         viewport like the loop-back icon does) */
      overflow: clip;
      z-index: 0;
      display: flex;
      align-items: center;
      cursor: pointer;
      border: 1px solid var(--global-divider-color);
      border-radius: 2px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
      transition: border-color 180ms ease;
    }

    .pdf-page--prev canvas,
    .pdf-page--next canvas {
      flex: 0 0 auto;
    }

    .pdf-page--prev {
      right: 100%;
      justify-content: flex-end;
    }

    .pdf-page--next {
      left: 100%;
      justify-content: flex-start;
    }

    .pdf-page--prev:hover,
    .pdf-page--prev:focus-visible,
    .pdf-page--next:hover,
    .pdf-page--next:focus-visible {
      border-color: var(--global-theme-color);
    }

    .pdf-page.is-empty {
      visibility: hidden;
      pointer-events: none;
    }

    /* Navigation hint over the side windows: a thin color layer above the
       PDF with a chevron floating at the same position as the loop-back
       icon. Hover marks the zone active in the theme color rather than
       highlighting the page content. */
    .pdf-page__hint {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      align-items: flex-start;
      justify-content: center;
