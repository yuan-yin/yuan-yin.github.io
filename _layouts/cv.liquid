      color: var(--global-text-color-light);
      font-size: 1.5rem;
      transition:
        background 180ms ease,
        color 180ms ease;
    }

    /* All three zone icons (prev / next / loop-back) sit on a circular
       liquid-glass pill: near-clear saturated backdrop + specular rim,
