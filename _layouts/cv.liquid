      cursor: not-allowed;
    }

    html[data-theme='dark'] .pager-mobile__btn:not(:hover):not(:disabled) {
      background: color-mix(in srgb, var(--global-theme-color) 12%, transparent);
    }

    /* The center page needs its own shadow to visually sit on top of the deck */
    .pdf-page--current canvas {
