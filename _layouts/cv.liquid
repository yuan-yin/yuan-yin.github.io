        inset 0.14rem 0.22rem 0.4rem -0.15rem rgba(255, 255, 255, 0.95),
        inset -0.12rem -0.2rem 0.35rem -0.15rem rgba(255, 255, 255, 0.7),
        inset 0 0 0.65rem 0.05rem rgba(255, 255, 255, 0.16);
      -webkit-backdrop-filter: blur(7px) saturate(1.6) brightness(1.04);
      backdrop-filter: blur(7px) saturate(1.6) brightness(1.04);
      font-size: 1.1rem;
    }

    html[data-theme='dark'] .pdf-page__hint i,
