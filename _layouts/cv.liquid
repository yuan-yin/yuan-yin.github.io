      transition:
        opacity 180ms ease,
        color 180ms ease,
        border-color 180ms ease,
        background 180ms ease;
    }

    .pdf-restart i,
    .pdf-restart i::before {
      color: inherit;
    }

    .pdf-restart:hover,
    .pdf-restart:focus-visible {
      opacity: 1;
      border-color: var(--global-theme-color);
      background: color-mix(in srgb, var(--global-theme-color) 9%, transparent);
      color: var(--global-theme-color);
    }

    .pdf-restart[hidden] {
      display: none;
    }

    /* Mobile pager: hidden on desktop where the side zones handle paging */
    .pager-mobile {
      display: none;
      gap: 0.5rem;
      align-items: center;
      justify-content: center;
      width: 100%;
      order: 3;
    }

    .pager-mobile__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.1rem;
      height: 2.1rem;
      padding: 0;
      border: 1px solid color-mix(in srgb, var(--global-theme-color) 42%, var(--global-divider-color));
      border-radius: 999px;
      background: color-mix(in srgb, var(--global-theme-color) 7%, transparent);
      color: var(--global-text-color);
      cursor: pointer;
      transition:
        background 160ms ease,
        border-color 160ms ease,
        color 160ms ease,
        opacity 160ms ease;
    }

    .pager-mobile__btn i,
    .pager-mobile__btn i::before {
      color: inherit;
    }

    .pager-mobile__btn:not(:disabled):hover,
    .pager-mobile__btn:not(:disabled):focus-visible {
      border-color: var(--global-theme-color);
      background: var(--global-theme-color);
      color: #ffffff;
